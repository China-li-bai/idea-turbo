{
  "name": "@make-gold/llm-adapter",
  "version": "1.0.0",
  "description": "A lightweight TypeScript library to unify different LLM API formats with priority for free APIs",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "keywords": [
    "llm",
    "api",
    "adapter",
    "typescript",
    "glm",
    "ernie",
    "hunyuan",
    "openrouter",
    "gemini"
  ],
  "author": "Make Gold Team",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "@types/node": "^20.6.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "eslint": "^8.49.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsup": "^7.2.0",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "axios": "^1.5.0",
    "eventsource": "^2.0.2",
    "tsx": "^4.20.6"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
