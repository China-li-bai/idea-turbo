# Umami Analytics Configuration
# 隐私友好的统计配置

# Umami Cloud (推荐)
# 注册 Umami Cloud: https://umami.is/
# 获取 Website ID: https://cloud.umami.is/settings/websites
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://analytics.umami.is/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-website-id-here

# 自托管 Umami (可选)
# 如果你自己部署 Umami，使用以下配置：
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://your-domain.com/script.js
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-website-id-here

# 禁用统计 (开发环境)
# 如果不想启用统计，留空即可：
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
