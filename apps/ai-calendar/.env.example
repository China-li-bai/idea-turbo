# ========================================
# AI Calendar Environment Variables
# ========================================

# ========================================
# Required Variables (必须配置)
# ========================================

# Application Environment
NODE_ENV=production

# ========================================
# AI Provider API Keys (至少配置一个)
# ========================================

# OpenAI API Key
# Get your key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Google Gemini API Key
# Get your key: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIza...

# Zhipu GLM API Key (智谱清言)
# Get your key: https://open.bigmodel.cn/api-keys
GLM_API_KEY=...

# Alibaba Bailian API Key (阿里云百炼)
# Get your key: https://dashscope.console.aliyun.com/apiKey
BAILIAN_API_KEY=sk-...

# ========================================
# Analytics (Optional)
# ========================================

# Umami Analytics Configuration
# Privacy-friendly analytics

# Umami Cloud (Recommended)
# Sign up: https://umami.is/
# Get Website ID: https://cloud.umami.is/settings/websites
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://analytics.umami.is/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-website-id-here

# Self-hosted Umami (Alternative)
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://your-domain.com/script.js
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-website-id-here

# Disable analytics (leave empty)
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ========================================
# Notes
# ========================================

# 1. Copy this file to .env.local for local development
# 2. Never commit .env.local to version control
# 3. At least one AI provider API key is required for AI features
# 4. All API keys are validated on application startup
