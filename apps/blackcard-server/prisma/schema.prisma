generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  openid        String    @unique
  unionId       String?   @unique
  phone         String?   @unique
  nickname      String?
  avatar        String?
  deviceFingerprint String?

  status        UserStatus @default(ACTIVE)
  role          UserRole   @default(FAN)

  kol           KOL?

  blackCards    BlackCard[]
  pointLedgers  PointLedger[]
  taskSubmissions TaskSubmission[]
  orders        Order[]
  invitationsAsInviter Invitation[] @relation("Inviter")
  invitationsAsInvitee Invitation[] @relation("Invitee")
  riskRecords   RiskRecord[]
  notifications Notification[]
  dailyCheckins DailyCheckin[]
  assistTasksAsInitiator AssistTask[] @relation("AssistInitiator")
  assistRecordsAsHelper  AssistRecord[] @relation("AssistHelper")
  lotteryDraws  LotteryDraw[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  @@index([openid])
  @@index([phone])
  @@index([status])
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum UserRole {
  FAN
  KOL
  ADMIN
}

model KOL {
  id              String  @id @default(cuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  name            String
  bio             String?
  avatar          String?
  wechatId        String?
  platform        String

  commissionRate  Float   @default(0.7)
  status          KOLStatus @default(PENDING)

  activities      Activity[]
  products        Product[]
  lotteryPools    LotteryPool[] @relation("KOLLotteryPools")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([platform])
}

enum KOLStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model Activity {
  id              String    @id @default(cuid())
  kolId           String
  kol             KOL       @relation(fields: [kolId], references: [id])

  title           String
  description     String?
  coverImage      String?

  prizeName       String
  prizeImage      String?
  prizeValue      Float

  blackCardQuota  Int       @default(100)
  blackCardIssued Int       @default(0)

  qualificationDays Int     @default(7)

  startDate       DateTime
  endDate         DateTime

  status          ActivityStatus @default(DRAFT)

  blackCards      BlackCard[]
  tasks           Task[]
  invitations     Invitation[]
  seasons         Season[]
  assistTasks     AssistTask[]
  lotteryPools    LotteryPool[] @relation("ActivityLotteryPools")

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([kolId])
  @@index([status])
  @@index([startDate, endDate])
}

enum ActivityStatus {
  DRAFT
  PUBLISHED
  ONGOING
  FINISHED
  CANCELLED
}

model Season {
  id              String    @id @default(cuid())
  activityId      String
  activity        Activity  @relation(fields: [activityId], references: [id])

  seasonNumber    Int
  name            String

  startDate       DateTime
  endDate         DateTime

  status          SeasonStatus @default(UPCOMING)

  demotionRules   Json?

  seasonRanks     SeasonRank[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([activityId, seasonNumber])
  @@index([activityId])
  @@index([status])
}

enum SeasonStatus {
  UPCOMING
  ACTIVE
  FINISHED
}

model SeasonRank {
  id              String    @id @default(cuid())
  seasonId        String
  season          Season    @relation(fields: [seasonId], references: [id])
  blackCardId     String
  blackCard       BlackCard @relation(fields: [blackCardId], references: [id])
  userId          String

  finalRank       Int       @default(0)
  finalPoints     Int       @default(0)
  finalTier       BlackCardTier?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([seasonId, userId])
  @@index([seasonId])
  @@index([blackCardId])
  @@index([finalRank])
}

model BlackCard {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  activityId      String
  activity        Activity    @relation(fields: [activityId], references: [id])

  cardNumber      String      @unique
  status          BlackCardStatus @default(ACTIVE)
  tier            BlackCardTier @default(BRONZE)

  totalPoints     Int         @default(0)
  currentRank     Int         @default(0)

  acquiredAt      DateTime    @default(now())
  expiresAt       DateTime?
  lastActiveAt    DateTime    @default(now())

  pointLedgers    PointLedger[]
  taskSubmissions TaskSubmission[]
  seasonRanks     SeasonRank[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([userId, activityId])
  @@index([userId])
  @@index([activityId])
  @@index([status])
  @@index([totalPoints])
}

enum BlackCardStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum BlackCardTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

model Task {
  id              String    @id @default(cuid())
  activityId      String
  activity        Activity  @relation(fields: [activityId], references: [id])

  title           String
  description     String?
  type            TaskType

  points          Int       @default(10)
  dailyLimit      Int       @default(1)
  totalLimit      Int?

  verificationType VerificationType @default(MANUAL)
  verificationConfig Json?

  status          TaskStatus @default(ACTIVE)

  submissions     TaskSubmission[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([activityId])
  @@index([type])
  @@index([status])
}

enum TaskType {
  SHARE_POST
  COMMENT
  LIKE
  CHECKIN
  CUSTOM
}

enum VerificationType {
  MANUAL
  OCR
  LINK_CLICK
  AUTO
}

enum TaskStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

model TaskSubmission {
  id              String    @id @default(cuid())
  taskId          String
  task            Task      @relation(fields: [taskId], references: [id])
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  blackCardId     String?
  blackCard       BlackCard? @relation(fields: [blackCardId], references: [id])

  proofImages     String[]
  proofText       String?
  proofData       Json?

  status          SubmissionStatus @default(PENDING)
  reviewedAt      DateTime?
  reviewedBy      String?
  reviewNote      String?

  pointsAwarded   Int       @default(0)
  pointsAwardedAt DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([taskId])
  @@index([userId])
  @@index([blackCardId])
  @@index([status])
  @@index([createdAt])
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model DailyCheckin {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  activityId      String
  blackCardId     String?

  checkinDate     DateTime
  consecutiveDays Int       @default(1)
  pointsAwarded   Int       @default(0)

  createdAt       DateTime  @default(now())

  @@unique([userId, activityId, checkinDate])
  @@index([userId])
  @@index([activityId])
  @@index([checkinDate])
}

model PointLedger {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  blackCardId     String?
  blackCard       BlackCard?  @relation(fields: [blackCardId], references: [id])

  type            PointType
  amount          Int
  balance         Int

  source          String
  sourceId        String?
  description     String?

  createdAt       DateTime    @default(now())

  @@index([userId])
  @@index([blackCardId])
  @@index([type])
  @@index([createdAt])
}

enum PointType {
  TASK_REWARD
  INVITE_BONUS
  PURCHASE_BONUS
  ASSIST_BONUS
  LOTTERY_COST
  LOTTERY_WIN
  SEASON_RESET
  PENALTY
  EXPIRATION
  ADMIN_ADJUST
}

model Product {
  id              String    @id @default(cuid())
  kolId           String
  kol             KOL       @relation(fields: [kolId], references: [id])
  activityId      String?

  name            String
  description     String?
  coverImage      String?
  images          String[]
  price           Float
  category        ProductCategory

  inventory       Int       @default(0)
  soldCount       Int       @default(0)

  bonusPoints     Int       @default(0)
  bonusType       ProductBonusType @default(NONE)

  shippingRequired Boolean  @default(false)

  status          ProductStatus @default(ACTIVE)

  orderItems      OrderItem[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([kolId])
  @@index([category])
  @@index([status])
}

enum ProductCategory {
  MERCHANDISE
  DIGITAL
  COURSE
  TICKET
  OTHER
}

enum ProductBonusType {
  NONE
  FIXED
  PERCENTAGE
}

enum ProductStatus {
  ACTIVE
  OFF_SHELF
  SOLD_OUT
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])

  orderNumber     String      @unique
  totalAmount     Float

  shippingAddress String?
  shippingName    String?
  shippingPhone   String?
  remark          String?

  trackingNumber  String?
  trackingCompany String?

  status          OrderStatus @default(PENDING_PAYMENT)

  paidAt          DateTime?
  shippedAt       DateTime?
  completedAt     DateTime?

  items           OrderItem[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

model OrderItem {
  id              String    @id @default(cuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id])
  productId       String
  product         Product   @relation(fields: [productId], references: [id])

  quantity        Int       @default(1)
  unitPrice       Float
  subtotal        Float
  bonusPoints     Int       @default(0)

  @@index([orderId])
  @@index([productId])
}

model Invitation {
  id              String    @id @default(cuid())
  inviterId       String
  inviter         User      @relation("Inviter", fields: [inviterId], references: [id])
  inviteeId       String
  invitee         User      @relation("Invitee", fields: [inviteeId], references: [id])

  activityId      String?
  activity        Activity?  @relation(fields: [activityId], references: [id])

  status          InvitationStatus @default(PENDING)

  bonusPoints     Int       @default(0)
  completedAt     DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([inviterId, inviteeId])
  @@index([inviterId])
  @@index([inviteeId])
  @@index([activityId])
  @@index([status])
}

enum InvitationStatus {
  PENDING
  COMPLETED
}

model AssistTask {
  id              String    @id @default(cuid())
  activityId      String
  activity        Activity  @relation(fields: [activityId], references: [id])

  initiatorId     String
  initiator       User      @relation("AssistInitiator", fields: [initiatorId], references: [id])

  targetCount     Int       @default(5)
  currentCount    Int       @default(0)
  bonusPoints     Int       @default(100)

  status          AssistTaskStatus @default(ACTIVE)

  assists         AssistRecord[]

  expiresAt       DateTime
  completedAt     DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([initiatorId])
  @@index([activityId])
  @@index([status])
}

model AssistRecord {
  id              String    @id @default(cuid())
  taskId          String
  task            AssistTask @relation(fields: [taskId], references: [id])

  helperId        String
  helper          User      @relation("AssistHelper", fields: [helperId], references: [id])

  createdAt       DateTime  @default(now())

  @@unique([taskId, helperId])
  @@index([taskId])
  @@index([helperId])
}

enum AssistTaskStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

model LotteryPool {
  id              String    @id @default(cuid())
  kolId           String
  kol             KOL       @relation("KOLLotteryPools", fields: [kolId], references: [id])
  activityId      String?
  activity        Activity? @relation("ActivityLotteryPools", fields: [activityId], references: [id])

  name            String
  description     String?
  coverImage      String?

  costPoints      Int

  status          LotteryPoolStatus @default(ACTIVE)

  prizes          LotteryPrize[]
  draws           LotteryDraw[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([kolId])
  @@index([status])
}

model LotteryPrize {
  id              String    @id @default(cuid())
  poolId          String
  pool            LotteryPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  name            String
  description     String?
  image           String?

  tier            LotteryPrizeTier @default(THANK_YOU)
  probability     Float

  totalStock      Int       @default(0)
  remainingStock  Int       @default(0)

  draws           LotteryDraw[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([poolId])
}

enum LotteryPrizeTier {
  LEGENDARY
  EPIC
  RARE
  COMMON
  THANK_YOU
}

enum LotteryPoolStatus {
  ACTIVE
  PAUSED
  CLOSED
}

model LotteryDraw {
  id              String    @id @default(cuid())
  poolId          String
  pool            LotteryPool @relation(fields: [poolId], references: [id])
  userId          String
  user            User      @relation(fields: [userId], references: [id])

  prizeId         String?
  prize           LotteryPrize? @relation(fields: [prizeId], references: [id])

  costPoints      Int
  status          LotteryDrawStatus @default(PENDING)

  claimedAt       DateTime?

  createdAt       DateTime  @default(now())

  @@index([poolId])
  @@index([userId])
  @@index([createdAt])
}

enum LotteryDrawStatus {
  PENDING
  COMPLETED
  CLAIMED
}

model Notification {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])

  title           String
  content         String
  type            NotificationType

  isRead          Boolean   @default(false)
  readAt          DateTime?

  relatedId       String?
  metadata        Json?

  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

enum NotificationType {
  SYSTEM
  POINTS
  TASK
  ACTIVITY
  INVITATION
  ORDER
}

model RiskRecord {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])

  riskType        String
  riskLevel       RiskLevel
  description     String?
  metadata        Json?

  resolved        Boolean   @default(false)
  resolvedAt      DateTime?
  resolvedBy      String?

  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([riskType])
  @@index([riskLevel])
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model SystemConfig {
  id              String    @id @default(cuid())
  key             String    @unique
  value           Json
  description     String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([key])
}
