{
  "name": "@idea-turbo/sherpa-onnx-tts",
  "version": "0.3.0",
  "description": "Kokoro TTS engine with Chinese support based on official kokoro.js core",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "phonemizer": "^1.2.1",
    "pinyin-pro": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.4"
  },
  "keywords": [
    "tts",
    "kokoro",
    "onnx",
    "webgpu",
    "speech-synthesis",
    "text-to-speech",
    "ai-voice",
    "chinese"
  ],
  "author": "Idea Turbo",
  "license": "MIT"
}
